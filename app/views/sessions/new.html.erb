<main
  class="
    relative flex min-h-svh items-center justify-center overflow-hidden px-4 py-16
  "
>
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute inset-x-0 -top-32 z-0 mx-auto h-72 max-w-xl
      rounded-full bg-primary/15 blur-[110px]
    "
  ></div>
  <div class="relative z-10 w-full max-w-md">

    <%= link_to root_path, class: "mb-8 flex items-center justify-center gap-2" do %>
      <div
        class="
          flex h-9 w-9 items-center justify-center rounded-lg bg-primary
          text-primary-foreground
        "
      >
        <%= image_tag "3d-printer.png", class: "h-5 w-5" %>
      </div>
      <span class="text-lg font-semibold tracking-tight">Print & Organize</span>
    <% end %>

    <div
      class="
        rounded-2xl border border-border bg-card/80 p-6 backdrop-blur-xl sm:p-8
      "
    >
      <div>
        <div class="text-center">
          <h1 class="text-balance text-2xl font-semibold tracking-tight sm:text-3xl">Bem-vindo de volta</h1>
          <p class="mt-2 text-pretty leading-relaxed text-muted-foreground">Entre na sua conta para gerenciar seus produtos.</p>
        </div>

        <%= form_with url: session_url, class: "mt-8 flex flex-col gap-5" do |f| %>
          <div class="flex flex-col gap-2">
            <%= render(LabelComponent.new(form: f, attribute: :email_address)) %>
            <%= render(
              InputComponent.new(
                form: f,
                attribute: :email_address,
                type: :email,
                class: "peer",
                placeholder: "seu@email.com.br",
                required: true,
              ),
            ) %>
          </div>

          <div class="flex flex-col gap-2" data-controller="password-visibility">
            <div class="flex items-center justify-between">
              <%= render(LabelComponent.new(form: f, attribute: :password)) %>
              <%= link_to "Esqueceu a senha?",
              new_password_path,
              class: "text-sm font-medium text-primary transition-colors hover:underline" %>
            </div>
            <%= render(
              InputComponent.new(
                form: f,
                attribute: :password,
                type: :password,
                toggleable: true,
                class: "peer",
                placeholder: "Sua senha",
                required: true,
              ),
            ) %>
          </div>

          <label
            class="
              flex cursor-pointer items-center gap-2 text-sm text-muted-foreground
            "
          ><input
              class="
                h-4 w-4 rounded border-border bg-input text-primary accent-primary
              "
              type="checkbox"
            >Manter conectado</label>

          <%= render(ButtonComponent.new(variant: :default)) { "Entrar" } %>
        <% end %>

        <p class="mt-6 text-center text-sm text-muted-foreground">
          Ainda não tem uma conta?
          <%= link_to signup_path, class: "font-medium text-primary transition-colors hover:underline" do %>
            Criar conta
          <% end %>
        </p>
      </div>
    </div>
  </div>
</main>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>
