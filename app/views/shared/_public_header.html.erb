<header
  class="
    bg-slate-900 dark:bg-slate-950 font-['Inter'] antialiased docked full-width
    top-0 sticky z-50 border-b border-slate-800 shadow-lg
  "
>
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <div class="text-xl font-bold tracking-tight text-white">Print &amp; Organize 3D</div>
    <nav class="hidden md:flex items-center gap-8">
      <a class="text-slate-300 hover:text-white transition-colors">Funcionalidades</a>
      <a class="text-slate-300 hover:text-white transition-colors">Como Funciona</a>
      <a class="text-slate-300 hover:text-white transition-colors">FAQ</a>
    </nav>
    <%= link_to signup_path, class: "bg-primary-container text-white px-6 py-3 rounded-lg font-button-label hover:opacity-90 transition-all active:scale-95 duration-200" do %>
      Começe gratuitamente
    <% end %>
  </div>
</header>
