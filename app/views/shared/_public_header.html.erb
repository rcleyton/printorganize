<header
  class="
    fixed sticky inset-x-0 top-0 z-50 border-b border-border/60 bg-background/70
    backdrop-blur-xl
  "
>
  <div
    class="
      mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6
    "
  >
    <a href="#" class="flex items-center gap-2">
      <div
        class="
          flex h-9 w-9 items-center justify-center rounded-lg bg-primary
          text-primary-foreground
        "
      >
        <%= image_tag "3d-printer.png", class: "h-5 w-5" %>
      </div>
      <span class="text-lg font-semibold tracking-tight">Print & Organize</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      <a
        href="#"
        class="
          text-sm text-muted-foreground transition-colors hover:text-foreground
        "
      >Benefícios</a>
      <a
        href="#"
        class="
          text-sm text-muted-foreground transition-colors hover:text-foreground
        "
      >Como funciona</a>
      <a
        href="#"
        class="
          text-sm text-muted-foreground transition-colors hover:text-foreground
        "
      >Depoimentos</a>
      <a
        href="#"
        class="
          text-sm text-muted-foreground transition-colors hover:text-foreground
        "
      >Perguntas</a>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <%= render(ButtonComponent.new(variant: :ghost, href: new_session_path)) do
        "Entrar"
      end %>
      <%= render(ButtonComponent.new(variant: :default, href: signup_path)) do
        "Começar grátis"
      end %>
    </div>
  </div>
</header>
