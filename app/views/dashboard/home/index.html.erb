<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>

<div class="min-h-screen bg-slate-50 flex">
  <div class="flex-1 flex flex-col min-w-0">
    <div class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto max-w-6xl mx-auto w-full">

      <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight sm:text-3xl">Olá,
            <%= current_user.email_address %></h1>
          <p class="text-slate-500 mt-1 text-sm">Aqui está o status em tempo real do seu laboratório 3D.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5">
        <div
          class="
            bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center
            justify-between
          ">
          <div>
            <span class="text-sm font-semibold text-slate-400 block">Total de Máquinas</span>
            <span class="text-3xl font-extrabold text-slate-900 mt-1 block"><%= @printers.count %></span>
          </div>
          <div
            class="
              size-12 bg-slate-50 text-slate-600 rounded-xl flex items-center justify-center
              border border-slate-100
            ">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
