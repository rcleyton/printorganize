<div class="min-h-screen bg-slate-50 flex">
  <div class="flex-1 flex flex-col min-w-0">
    <main
      class="
        flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto max-w-5xl mx-auto w-full space-y-6
      "
    >
      <div
        class="
          flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b
          border-slate-200
        "
      >
        <div>
          <%= link_to dashboard_printers_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-800 transition-colors mb-2" do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Voltar para lista
          <% end %>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight sm:text-3xl"><%= @printer.printer_name %></h1>
            <span
              class="
                inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold
                bg-slate-100 text-slate-600
              "
            >
              Ociosa
            </span>
          </div>
          <p class="text-slate-500 text-sm mt-1"><%= @printer.printer_brand %>
            —
            <%= @printer.printer_model %></p>
        </div>

        <div class="flex items-center gap-3">
          <%= link_to edit_dashboard_printer_path(@printer), class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold rounded-xl shadow-sm transition-all text-sm flex-1 sm:flex-none" do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 text-slate-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              />
            </svg>
            <span>Editar</span>
          <% end %>

          <%= button_to dashboard_printer_path(@printer), method: :delete, data: { confirm: "Tem certeza que deseja remover esta impressora?" }, class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-red-50 hover:bg-red-100 text-red-600 font-semibold rounded-xl transition-all text-sm w-full sm:w-auto border border-red-100 cursor-pointer" do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
              />
            </svg>
            <span>Excluir</span>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <h3
              class="
                text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center
                gap-2
              "
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 5h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z"
                /></svg>
              Especificações Gerais
            </h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Marca do Fabricante</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5"><%= @printer.printer_brand %></dd>
              </div>

              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Modelo do Equipamento</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5"><%= @printer.printer_model %></dd>
              </div>

              <div class="border-b border-slate-50 pb-2 sm:border-none sm:pb-0">
                <dt class="text-xs font-semibold text-slate-400">Número de Série</dt>
                <dd class="text-sm font-mono font-semibold text-slate-700 mt-0.5">
                  <%= @printer.serial.present? ? @printer.serial : "Não informado" %>
                </dd>
              </div>

              <div class="sm:border-none sm:pb-0">
                <dt class="text-xs font-semibold text-slate-400">Consumo de Energia Nominal</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5">
                  <%= if @printer.kilowatt_hour.present?
                    "#{@printer.kilowatt_hour} kWh"
                  else
                    "Não calculado"
                  end %>
                </dd>
              </div>
            </dl>
          </div>

          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
              <h3
                class="
                  text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center
                  gap-2
                "
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  /></svg>
                Histórico Recente
              </h3>
              <span class="text-[11px] text-slate-400 font-medium">Últimos 30 dias</span>
            </div>

            <div
              class="
                text-center py-8 text-slate-400 border border-dashed border-slate-100 rounded-xl
              "
            >
              <p class="text-sm font-medium">Nenhum gcode ou projeto executado nesta máquina ainda.</p>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div
            class="
              bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4
            "
          >
            <h3
              class="
                text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center
                gap-2
              "
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"
                /></svg>
              Conexão Local
            </h3>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3">
              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Endereço de IP</span>
                <% if @printer.printer_ip.present? %>
                  <p class="text-sm font-mono font-bold text-slate-800 mt-0.5"><%= @printer.printer_ip %></p>
                <% else %>
                  <p class="text-sm italic text-slate-400 mt-0.5">Sem IP configurado</p>
                <% end %>
              </div>

              <div data-controller="password-visibility">
                <span
                  class="
                    text-[10px] uppercase font-bold text-slate-400 tracking-wider block
                  "
                >Chave de API / Código</span>
                <% if @printer.access_code.present? %>
                  <div
                    class="
                      flex items-center justify-between mt-1 bg-white px-3 py-1.5 rounded-lg border
                      border-slate-200
                    "
                  >
                    <input
                      type="password"
                      value="<%= @printer.access_code %>"
                      readonly
                      data-password-visibility-target="input"
                      class="
                        text-xs font-mono font-bold text-slate-700 bg-transparent outline-none w-full
                        border-none p-0 focus:ring-0
                      "
                    >
                    <button
                      type="button"
                      data-action="password-visibility#toggle"
                      class="
                        text-slate-400 hover:text-[#60c2a6] transition-colors shrink-0 ml-2
                      "
                    >
                      <span data-password-visibility-target="icon">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="size-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                          /><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                          /></svg>
                      </span>
                      <span data-password-visibility-target="icon" class="hidden">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="size-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                          /></svg>
                      </span>
                    </button>
                  </div>
                <% else %>
                  <p class="text-sm italic text-slate-400 mt-0.5">Nenhuma chave salva</p>
                <% end %>
              </div>
            </div>

            <% if @printer.printer_ip.present? %>
              <%= link_to "http://#{@printer.printer_ip}", target: "_blank", class: "w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-center font-semibold rounded-xl text-xs transition-colors flex items-center justify-center gap-2" do %>
                <span>Acessar Interface Web</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  /></svg>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
