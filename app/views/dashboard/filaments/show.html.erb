<div class="min-h-screen bg-slate-50 flex">
  <div class="flex-1 flex flex-col min-w-0">
    <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto max-w-5xl mx-auto w-full space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
          <%= link_to dashboard_filaments_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-800 transition-colors mb-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Voltar para lista
          <% end %>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight sm:text-3xl"><%= @filament.name %></h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold uppercase bg-slate-100 text-slate-600">
              <%= @filament.material_type.upcase %>
            </span>
          </div>
          <p class="text-slate-500 text-sm mt-1">Marca: <%= @filament.brand %> · Cor: <%= @filament.color %></p>
        </div>

        <div class="flex items-center gap-3">
          <%= link_to edit_dashboard_filament_path(@filament), class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold rounded-xl shadow-sm transition-all text-sm flex-1 sm:flex-none" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Editar</span>
          <% end %>

          <%= button_to dashboard_filament_path(@filament), method: :delete, data: { confirm: "Tem certeza que deseja remover este filamento?" }, class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-red-50 hover:bg-red-100 text-red-600 font-semibold rounded-xl transition-all text-sm w-full sm:w-auto border border-red-100 cursor-pointer" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Excluir</span>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 5h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z" />
              </svg>
              Especificações do Material
            </h3>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Marca</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5"><%= @filament.brand %></dd>
              </div>

              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Tipo de Material</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5 uppercase"><%= @filament.material_type %></dd>
              </div>

              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Cor</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5"><%= @filament.color %></dd>
              </div>

              <div class="border-b border-slate-50 pb-2">
                <dt class="text-xs font-semibold text-slate-400">Peso Inicial</dt>
                <dd class="text-sm font-bold text-slate-800 mt-0.5">
                  <%= number_with_precision(@filament.initial_weight, precision: 0, delimiter: ".") %> g
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Custo
            </h3>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3">
              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Preço de Compra</span>
                <p class="text-lg font-bold text-slate-900 mt-0.5">
                  <%= number_to_currency(@filament.purchase_price, unit: "R$", separator: ",", delimiter: ".") %>
                </p>
              </div>

              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Preço por Grama</span>
                <p class="text-md font-bold text-slate-700 mt-0.5">
                  <%= @filament.price_per_gram.present? ? "#{number_to_currency(@filament.price_per_gram, unit: "R$", precision: 4, separator: ",", delimiter: ".")} / g" : "—" %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
