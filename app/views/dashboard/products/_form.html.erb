<%= form_with model: [:dashboard, @product], local: true, class: "mt-8 rounded-xl border border-border bg-card p-6 sm:p-8" do |f| %>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <%= render(LabelComponent.new(form: f, attribute: :category)) %>
      <%= render(
        InputComponent.new(
          form: f,
          attribute: :category,
          placeholder: "Categoria do produto",
        ),
      ) %>
    </div>
    <div class="flex flex-col gap-2">
      <%= render(LabelComponent.new(form: f, attribute: :status)) %>
      <%= render(
        SelectComponent.new(
          form: f,
          attribute: :status,
          collection: Product.statuses.keys.map { |k| [k.humanize, k] },
          include_blank: "Status do produto",
        ),
      ) %>
    </div>
    <div class="flex flex-col gap-2 sm:col-span-2">
      <%= render(LabelComponent.new(form: f, attribute: :name)) %>
      <%= render(
        InputComponent.new(
          form: f,
          attribute: :name,
          placeholder: "Ex: Suporte de Celular",
        ),
      ) %>
    </div>
    <div class="flex flex-col gap-2 sm:col-span-2">
      <%= render(LabelComponent.new(form: f, attribute: :description)) %>
      <%= render(
        InputComponent.new(
          form: f,
          attribute: :description,
          placeholder: "Descrição do produto",
        ),
      ) %>
    </div>
    <div class="flex flex-col gap-2">
      <%= render(LabelComponent.new(form: f, attribute: :material_weight)) %>
      <%= render(
        InputComponent.new(
          form: f,
          attribute: :material_weight,
          placeholder: "Peso do material em gramas",
        ),
      ) %>
    </div>
    <div class="flex flex-col gap-2">
      <%= render(LabelComponent.new(form: f, attribute: :production_time_seconds)) %>
      <%= render(
        InputComponent.new(
          form: f,
          attribute: :production_time_seconds,
          placeholder: "Tempo de impressão",
        ),
      ) %>
    </div>
  </div>
  <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <%= link_to "Cancelar",
    dashboard_products_path,
    class:
      "group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 bg-secondary text-secondary-foreground hover:bg-secondary/80 aria-expanded:bg-secondary aria-expanded:text-secondary-foreground h-8 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2" %>
    <%= f.submit class: "group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 h-8 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-save h-4 w-4"
        aria-hidden="true"
      ><path
          d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
        ></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
    <% end %>
  </div>
<% end %>
