<main
  class="
    relative flex min-h-svh items-center justify-center overflow-hidden px-4 py-16
  "
>
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute inset-x-0 -top-32 z-0 mx-auto h-72 max-w-xl
      rounded-full bg-primary/15 blur-[110px]
    "
  ></div>
  <div class="relative z-10 w-full max-w-md">

    <%= link_to root_path, class: "mb-8 flex items-center justify-center gap-2" do %>
      <div
        class="
          flex h-9 w-9 items-center justify-center rounded-lg bg-primary
          text-primary-foreground
        "
      >
        <%= image_tag "3d-printer.png", class: "h-5 w-5" %>
      </div>
      <span class="text-lg font-semibold tracking-tight">Print & Organize</span>
    <% end %>

    <div
      class="
        rounded-2xl border border-border bg-card/80 p-6 backdrop-blur-xl sm:p-8
      "
    >
      <div>
        <div class="text-center">
          <h1 class="text-balance text-2xl font-semibold tracking-tight sm:text-3xl">Recuperar senha</h1>
          <p class="mt-2 text-pretty leading-relaxed text-muted-foreground">Digite seu e-mail para receber as instruções de redefinição de
            senha.</p>
        </div>

        <%= form_with url: passwords_path, class: "mt-8 flex flex-col gap-5" do |f| %>
          <div class="flex flex-col gap-2">
            <%= render(LabelComponent.new(form: f, attribute: :email_address)) %>
            <%= render(
              InputComponent.new(
                form: f,
                attribute: :email_address,
                type: :email,
                class: "peer",
                placeholder: "seu@email.com.br",
                required: true,
              ),
            ) %>
          </div>

          <%= render(ButtonComponent.new(variant: :default)) do
            "Enviar instruções por E-mail"
          end %>
        <% end %>

        <p class="mt-6 text-center text-sm text-muted-foreground">
          <%= link_to new_session_path, class: "font-medium text-primary transition-colors hover:underline" do %>
            Voltar para login
          <% end %>
        </p>

      </div>
    </div>
  </div>
</main>

<turbo-frame id="flash">
  <%= render "shared/flash" %>
</turbo-frame>
