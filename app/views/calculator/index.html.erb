<main class="min-h-screen">
  <%= render partial: "shared/public_header" %>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="
          inline-flex items-center gap-2 rounded-full border border-border bg-card px-3
          py-1 text-xs font-medium text-muted-foreground
        "
      >
        <span class="material-symbols-outlined">
          calculate
        </span>
        Ferramenta gratuita
      </div>

      <h1 class="mt-5 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        Calculadora de precificação 3D
      </h1>

      <p
        class="
          mx-auto mt-4 max-w-xl text-pretty leading-relaxed text-muted-foreground
        "
      >
        Preencha os campos abaixo e descubra o preço de venda ideal para o seu
        produto impresso em 3D. Os cálculos são atualizados em tempo real.
      </p>
    </div>

    <div class="mt-12">
      <div data-controller="calculator" class="grid gap-8 lg:grid-cols-[1fr_380px]">
        <div class="flex flex-col gap-6">
          <section class="rounded-2xl border border-border bg-card p-6">
            <div class="flex items-start gap-3">
              <div
                class="
                  flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/15
                  text-primary
                "
              >
                <span class="material-symbols-outlined">
                  3d
                </span>
              </div>
              <div>
                <h2 class="text-lg font-semibold tracking-tight">Insumos e Impressão</h2>
                <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Material, tempo e energia gastos na impressão.</p>
              </div>
            </div>

            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "filament-price")) { "Valor do filamento" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :filament_price,
                      data: {
                        calculator_target: "filament_price",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$ / kg
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "filament-weight")) do
                  "Peso do filamento utilizado"
                end %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :filament_weight,
                      data: {
                        calculator_target: "filament_weight",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    g
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "printer_time")) { "Tempo de impressão" } %>
                <div class="grid grid-cols-2 gap-3">
                  <div class="relative">
                    <%= render(
                      InputComponent.new(
                        type: :number,
                        id: :printing_hours,
                        data: {
                          calculator_target: "printing_hours",
                          action: "input->calculator#calculate",
                        },
                        value: 0,
                      ),
                    ) %>
                    <span
                      class="
                        pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                        font-medium text-muted-foreground
                      "
                    >
                      h
                    </span>
                  </div>
                  <div class="relative">
                    <%= render(
                      InputComponent.new(
                        type: :number,
                        id: :printing_minutes,
                        data: {
                          calculator_target: "printing_minutes",
                          action: "input->calculator#calculate",
                        },
                        value: 0,
                      ),
                    ) %>
                    <span
                      class="
                        pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                        font-medium text-muted-foreground
                      "
                    >
                      min
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "kilowatt_hour")) { "Consumo de energia" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :kilowatt_hour,
                      data: {
                        calculator_target: "kilowatt_hour",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    kW
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "kilowatt_price")) do
                  "Preço do kWh na sua cidade"
                end %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :kilowatt_price,
                      data: {
                        calculator_target: "kilowatt_price",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$
                  </span>
                </div>
              </div>

            </div>
          </section>

          <section class="rounded-2xl border border-border bg-card p-6">
            <div class="flex items-start gap-3">
              <div
                class="
                  flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/15
                  text-primary
                "
              >
                <span class="material-symbols-outlined">
                  build
                </span>
              </div>
              <div>
                <h2 class="text-lg font-semibold tracking-tight">Custos Operacionais</h2>
                <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Desgaste do equipamento, seu trabalho e embalagem.</p>
              </div>
            </div>

            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "maintenance")) { "Manutenção/Desgaste" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :maintenance,
                      data: {
                        calculator_target: "maintenance",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$ / h
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "value_hour_worked")) do
                  "Valor da sua hora de trabalho"
                end %>
                <div class="grid grid-cols-2 gap-2">
                  <div class="relative">
                    <%= render(
                      InputComponent.new(
                        type: :number,
                        id: :value_hour_worked,
                        data: {
                          calculator_target: "value_hour_worked",
                          action: "input->calculator#calculate",
                        },
                        value: 0,
                      ),
                    ) %>
                    <span
                      class="
                        pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                        font-medium text-muted-foreground
                      "
                    >
                      R$
                    </span>
                  </div>

                  <div class="relative">
                    <%= render(
                      InputComponent.new(
                        type: :number,
                        id: :hour_worked,
                        data: {
                          calculator_target: "hour_worked",
                          action: "input->calculator#calculate",
                        },
                        value: 0,
                      ),
                    ) %>
                    <span
                      class="
                        pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                        font-medium text-muted-foreground
                      "
                    >
                      h
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "packaging")) { "Embalagem" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :packaging,
                      data: {
                        calculator_target: "packaging",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$
                  </span>
                </div>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-border bg-card p-6">
            <div class="flex items-start gap-3">
              <div
                class="
                  flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/15
                  text-primary
                "
              >
                <span class="material-symbols-outlined">
                  storefront
                </span>
              </div>
              <div>
                <h2 class="text-lg font-semibold tracking-tight">Marketplaces e Taxas</h2>
                <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Onde você vende e quanto isso custa.</p>
              </div></div><div class="mt-6 grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "marketplace_fee")) { "Taxa do marketplace" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :marketplace_fee,
                      data: {
                        calculator_target: "marketplace_fee",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    %
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "fixed_marketplace_fee")) do
                  "Taxa fixa do marketplace"
                end %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :fixed_marketplace_fee,
                      data: {
                        calculator_target: "fixed_marketplace_fee",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$
                  </span>
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "shipping")) { "Frete" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: :shipping,
                      data: {
                        calculator_target: "shipping",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    R$
                  </span>
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <%= render(LabelComponent.new(for: "profit_margin")) { "Margem de lucro" } %>
                <div class="relative">
                  <%= render(
                    InputComponent.new(
                      type: :number,
                      id: "profit_margin",
                      data: {
                        calculator_target: "profit_margin",
                        action: "input->calculator#calculate",
                      },
                      value: 0,
                    ),
                  ) %>
                  <span
                    class="
                      pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-xs
                      font-medium text-muted-foreground
                    "
                  >
                    %
                  </span>

                </div>
              </div>
            </div>
          </section>
        </div>

        <div class="lg:sticky lg:top-24 lg:self-start">
          <div class="overflow-hidden rounded-2xl border border-border bg-card">
            <div class="border-b border-border bg-secondary/40 px-6 py-5">
              <p class="text-sm font-medium text-muted-foreground">Preço de venda sugerido</p>
              <p
                data-calculator-target="suggested_price"
                class="mt-1 text-4xl font-semibold tracking-tight text-primary"
              >R$ 0,00</p>
              <p class="mt-2 text-xs text-muted-foreground">Lucro líquido estimado de
                <span data-calculator-target="net_profit" class="font-semibold text-foreground">R$ 0,00</span></p>
            </div>

            <div class="flex flex-col gap-3 px-6 py-5 text-sm">
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Custo filamento</span>
                <span data-calculator-target="result_filament_cost" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Custo de energia</span>
                <span data-calculator-target="result_energy_cost" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Manutenção</span>
                <span data-calculator-target="total_maintenance" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Mão de obra</span>
                <span data-calculator-target="total_hour_worked" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Embalagem</span>
                <span data-calculator-target="total_packaging" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="my-1 border-t border-border"></div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 font-medium text-foreground">
                  Custo de produção
                </span>
                <span
                  data-calculator-target="total_production_cost"
                  class="font-semibold text-foreground"
                >R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Margem de lucro</span>
                <span data-calculator-target="result_profit" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Frete</span>
                <span data-calculator-target="final_shipping" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Taxa fixa do marketplace</span>
                <span
                  data-calculator-target="final_fixed_marketplace_fee"
                  class="text-foreground"
                >R$ 0,00</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground">Taxa de marketplace</span>
                <span data-calculator-target="final_marketplace_fee" class="text-foreground">R$ 0,00</span>
              </div>
              <div class="my-1 border-t border-border"></div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 font-medium text-foreground">Preço final</span>
                <span
                  data-calculator-target="final_price"
                  class="text-base font-semibold text-primary"
                >R$ 0,00</span>
              </div>
            </div>
            <div class="px-6 pb-6">
              <button
                type="button"
                tabindex="0"
                data-slot="button"
                data-action="click->calculator#reset"
                class="
                  group/button inline-flex shrink-0 items-center justify-center rounded-lg border
                  border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap
                  transition-all outline-none select-none focus-visible:border-ring
                  focus-visible:ring-3 focus-visible:ring-ring/50
                  active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none
                  disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3
                  aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50
                  dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none
                  [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-secondary
                  text-secondary-foreground hover:bg-secondary/80 aria-expanded:bg-secondary
                  aria-expanded:text-secondary-foreground h-8 gap-1.5 px-2.5
                  has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full
                "
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-rotate-ccw h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
                Restaurar valores
              </button>
            </div>
          </div>

          <p class="mt-4 px-1 text-xs leading-relaxed text-muted-foreground">
            A taxa do marketplace é aplicada sobre o preço final, garantindo
            que sua margem de lucro seja preservada após o desconto da
            comissão.
          </p>
        </div>
      </div>
    </div>

  </div>
</main>
